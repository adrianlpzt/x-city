# Copia este archivo como `.env` (o `.env.local`) para cambiar la configuración.

# De dónde salen los tweets:
#   mock -> datos simulados (por defecto)
#   x    -> backend propio en /api/timeline (todavía NO implementado: mostrará un aviso)
VITE_TWEET_SOURCE=mock

# URL base del backend cuando VITE_TWEET_SOURCE=x (vacío = mismo origen, p. ej. con el proxy de Vite)
VITE_API_BASE=
